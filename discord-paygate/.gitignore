.env
data/
node_modules/
*.sqlite
*.sqlite-wal
*.sqlite-shm

# scripts/post-message.mjs dry-run output — a render for review, never committed
tmp-post-preview/

# scripts/record-hero.mjs output — regenerated, never committed
tmp-hero-frames/

# scripts/build-film.mjs frame output — regenerated, never committed.
# The glob matters: FILM_CUT=dark writes tmp-film-frames-dark/, which the bare
# `tmp-film-frames/` rule did not match, and 600 4K PNGs per render went into
# three commits before anyone noticed.
tmp-film-frames*/

# Scratch probes written by audit subagents while they measure the render.
# Throwaway by construction. A `git add -A` swept five of them into a commit
# before any pattern existed, and a sixth landed in hero/ rather than scripts/
# and was mirrored to production before it was caught — hence the second rule,
# which is deliberately not scoped to a directory.
scripts/_*
probe*.mjs
**/probe*.mjs

# The same files, under the other name they get written with. A Playwright
# script has to sit INSIDE this package — an ESM import resolves `playwright`
# relative to the script's own location, not the working directory — so an
# audit agent cannot keep its harness in a scratch directory the way it keeps
# its screenshots. The leading dot is the convention that marks one throwaway.
# `.scratch-*` is the name to reach for; the rest are prefixes already in use.
.scratch-*
.audit-*
.dtaudit-*
.pw-*
.navcheck*
.verify-*
.shot-*
.probe*

# Screenshots and one-off harnesses written while eyeballing a render. Same
# throwaway class as the dot-prefixed names above, just under a directory so
# a run's artifacts stay together instead of littering the package root.
scratch/
tmp-hero-frames/
tmp-film-audio.wav
remotion/node_modules/
.playwright-cli/
