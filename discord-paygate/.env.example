# On Vercel, set these in Project → Settings → Environment Variables.
# This file is for local development only (loaded by npm start / npm test).

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
# Public origin buyers reach the app on (used for OAuth redirect + checkout
# return URLs). On Vercel: https://<your-project>.vercel.app or your domain.
PUBLIC_BASE_URL=http://localhost:4000
# Secret used to sign login session cookies. Generate: openssl rand -hex 32
SESSION_SECRET=change-me
# Secret guarding /api/cron/reconcile. Generate: openssl rand -hex 32
# Vercel's cron scheduler automatically sends it as "Authorization: Bearer <value>".
CRON_SECRET=change-me-too

# ── Storage ───────────────────────────────────────────────────────────────────
# Postgres connection string (REQUIRED in production — serverless filesystems
# are ephemeral). From Vercel: Storage → Create Database → Neon/Supabase, or
# any Postgres provider. Prefer the POOLED connection string.
# The code reads DATABASE_URL first and falls back to POSTGRES_URL, so the
# variable Vercel's Postgres integration injects automatically also works.
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# Local fallback when neither is set: a SQLite file (dev/tests only).
DB_PATH=data/paygate.sqlite

# ── Discord ───────────────────────────────────────────────────────────────────
# Application (OAuth2) credentials from https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Bot token (Bot tab of the same application)
DISCORD_BOT_TOKEN=
# The server (guild) whose roles are sold
DISCORD_GUILD_ID=
# Display name of that server (shown on the order receipt: "Open <name> on Discord")
DISCORD_GUILD_NAME=
# Override only in tests / self-hosted proxies
DISCORD_API_BASE=https://discord.com/api/v10

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint pointing at /webhooks/stripe
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE=https://api.stripe.com

# ── Coinbase Commerce (OPTIONAL — leave empty for Stripe-only) ────────────────
# When empty: the crypto CTA is hidden and the coinbase endpoints answer 501.
# The code stays dormant, not deleted; fill these in to re-enable crypto.
COINBASE_API_KEY=
COINBASE_WEBHOOK_SECRET=
COINBASE_API_BASE=https://api.commerce.coinbase.com

# ── Behaviour ─────────────────────────────────────────────────────────────────
# Reject webhooks whose timestamp is further than this from now (replay defence)
WEBHOOK_TOLERANCE_SECONDS=300
# How long a member keeps access after a failed payment on a renewing plan
GRACE_PERIOD_HOURS=72
