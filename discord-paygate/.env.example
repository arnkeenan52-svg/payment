# On Vercel, set these in Project → Settings → Environment Variables.
# This file is for local development only (loaded by npm start / npm test).

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
# Public origin buyers reach the app on (used for OAuth redirect + checkout
# return URLs). On Vercel: https://<your-project>.vercel.app or your domain.
PUBLIC_BASE_URL=http://localhost:4000
# Secret used to sign login session cookies. Generate: openssl rand -hex 32
SESSION_SECRET=change-me
# Secret guarding /api/cron/reconcile. Generate: openssl rand -hex 32
# Vercel's cron scheduler automatically sends it as "Authorization: Bearer <value>".
CRON_SECRET=change-me-too

# ── Storage ───────────────────────────────────────────────────────────────────
# Postgres connection string (REQUIRED in production — serverless filesystems
# are ephemeral). From Vercel: Storage → Create Database → Neon/Supabase, or
# any Postgres provider. Prefer the POOLED connection string.
# The code reads DATABASE_URL first and falls back to POSTGRES_URL, so the
# variable Vercel's Postgres integration injects automatically also works.
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# POSTGRES_URL=   (the name Vercel's Postgres integration injects; read only when DATABASE_URL is unset)
# Local fallback when neither is set: a SQLite file (dev/tests only).
DB_PATH=data/paygate.sqlite

# Host checkout platform name shown in the UI chrome (default: Dues)
# PLATFORM_NAME=Dues
# Name of the BUILT-IN store — the one DISCORD_GUILD_ID below sells. It is the
# store's URL slug (/tradeleaks), its display name, and the name buyer-facing
# messages fall back to (failed-payment DM, crypto order description). Set it
# to the community's own name; changing it later moves the store's URL.
BRAND=Tradeleaks
# Permanent invite to the Dues community server. Backs every "Join our Discord"
# button (/api/community) AND the receipt email's footer link — one value, both
# surfaces. Re-issue the invite here, no deploy needed. (DISCORD_COMMUNITY_INVITE
# is the older name for the same setting and is still honoured.)
# COMMUNITY_INVITE=https://discord.gg/...
# DISCORD_COMMUNITY_INVITE=   (older name for the same setting; COMMUNITY_INVITE wins when both are set)

# ── Discord ───────────────────────────────────────────────────────────────────
# Application (OAuth2) credentials from https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Bot token (Bot tab of the same application)
DISCORD_BOT_TOKEN=
# The server (guild) whose roles are sold
DISCORD_GUILD_ID=
# OPTIONAL display-name override — when empty, the live guild name from
# Discord is used automatically (nothing is shown until it's known)
DISCORD_GUILD_NAME=
# YOUR Discord user id — signing in with this account unlocks the owner-only
# owner-only setup-doctor detail (npm run doctor / dashboard checklist)
OWNER_DISCORD_ID=
# Override only in tests / self-hosted proxies
DISCORD_API_BASE=https://discord.com/api/v10

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint pointing at /webhooks/stripe
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE=https://api.stripe.com

# ── Coinbase Commerce (OPTIONAL — leave empty for Stripe-only) ────────────────
# When empty: the crypto CTA is hidden and the coinbase endpoints answer 501.
# The code stays dormant, not deleted; fill these in to re-enable crypto.
COINBASE_API_KEY=
COINBASE_WEBHOOK_SECRET=
COINBASE_API_BASE=https://api.commerce.coinbase.com
# Legacy Coinbase rail: same release discipline — blank keeps it off.
COINBASE_RELEASED=

# ── NOWPayments (OPTIONAL — the crypto rail sellers actually use) ─────────────
# Both are required. The key alone cannot verify an IPN, and an unverified IPN
# is an anonymous request claiming somebody paid. With either missing, the
# crypto CTA is hidden and /api/webhooks/nowpayments answers 501.
#
# The IPN secret is generated in the NOWPayments dashboard (Settings → IPN) and
# is shown ONCE. There is no IPN URL field there, so the callback rides on every
# payment we create — nothing to configure on their side.
#
# Payouts forward straight to each seller's own wallet, set per store in the
# dashboard. Dues never holds funds and never reads an account balance.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_API_BASE=https://api.nowpayments.io/v1
# The release gate. The credentials above make the rail POSSIBLE; this makes it
# LIVE. Leave blank until the crypto rail has been re-verified end to end.
NOWPAYMENTS_RELEASED=

# ── Resend (receipt emails — OPTIONAL, but silent when missing) ───────────────
# Membership-confirmation emails go out through Resend. With no key the send
# is skipped without error: the buyer gets their role and NO receipt, and only
# the setup doctor (email:resend-key) says why. The key can instead be saved
# from the dashboard, which stores it sealed in the database.
RESEND_API_KEY=
# Sender address. Leave empty and the first VERIFIED domain in the Resend
# account is used automatically; Resend's onboarding@resend.dev test sender
# delivers only to the account owner, so never put that here.
# RECEIPT_FROM=Dues <receipts@your-domain>
# Override only in tests / self-hosted proxies
RESEND_API_BASE=https://api.resend.com

# ── Behaviour ─────────────────────────────────────────────────────────────────
# Reject webhooks whose timestamp is further than this from now (replay defence)
WEBHOOK_TOLERANCE_SECONDS=300
# How long a member keeps access after a failed payment on a renewing plan
GRACE_PERIOD_HOURS=72
# How long the guild role list is cached for name-based role resolution
ROLE_CACHE_SECONDS=60
# How long /api/setup-check keeps a doctor report before re-running the live
# checks (owner and cron callers can force one with ?fresh=1)
DOCTOR_CACHE_SECONDS=300
