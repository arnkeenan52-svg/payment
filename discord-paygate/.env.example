# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
# Public origin buyers reach the app on (used for OAuth redirect + checkout return URLs)
PUBLIC_BASE_URL=http://localhost:4000
# Secret used to sign login session cookies. Generate: openssl rand -hex 32
SESSION_SECRET=change-me
# SQLite database file
DB_PATH=data/paygate.sqlite

# ── Discord ───────────────────────────────────────────────────────────────────
# Application (OAuth2) credentials from https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Bot token (Bot tab of the same application)
DISCORD_BOT_TOKEN=
# The server (guild) whose roles are sold
DISCORD_GUILD_ID=
# Override only in tests / self-hosted proxies
DISCORD_API_BASE=https://discord.com/api/v10

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint pointing at /webhooks/stripe
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE=https://api.stripe.com

# ── Coinbase Commerce ─────────────────────────────────────────────────────────
COINBASE_API_KEY=
# Shared secret shown on the Coinbase Commerce webhook settings page
COINBASE_WEBHOOK_SECRET=
COINBASE_API_BASE=https://api.commerce.coinbase.com

# ── Behaviour ─────────────────────────────────────────────────────────────────
# Reject webhooks whose timestamp is further than this from now (replay defence)
WEBHOOK_TOLERANCE_SECONDS=300
# How long a member keeps access after a failed renewal before roles are pulled
GRACE_PERIOD_HOURS=72
# How often the expiry sweep runs
SWEEP_INTERVAL_SECONDS=600
